# Generate with: openssl rand -hex 32
ACCESS_TOKEN=replace-with-a-random-64-character-token
PUBLIC_BASE_URL=https://stream.crespo.com.br
CHANNELS_CONFIG=/opt/youtube-m3u8/channels.json
PLAYLIST_DIR=/var/lib/youtube-m3u8/playlists

# DNS-only Cloudflare record updater (optional but recommended for dynamic IPs).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
PUBLIC_HOST=stream.crespo.com.br
